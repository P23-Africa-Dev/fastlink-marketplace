# ==============================================================================
# Frontend (Next.js) — Vercel production
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.fastlinkmarketplace.com/api

# Paystack keys live in backend/.env only (not here).
# Callback URL: https://fastlinkmarketplace.com/checkout/callback

# ==============================================================================
# Local development overrides (.env.local — do not commit)
# ==============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ==============================================================================
# Optional: local E2E test credentials (never set NEXT_PUBLIC_* passwords in production)
# ==============================================================================
# TEST_ADMIN_EMAIL=admin@fastlink.test
# TEST_ADMIN_PASSWORD=password
# TEST_SELLER_EMAIL=seller@fastlink.test
# TEST_SELLER_PASSWORD=password
# TEST_BUYER_EMAIL=buyer@fastlink.test
# TEST_BUYER_PASSWORD=password
